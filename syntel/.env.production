# Syntel Production Environment Variables
# Copy this file to .env and fill in your production values

# Django Configuration
DJANGO_SECRET_KEY=your-super-secret-key-here-minimum-50-characters
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_SETTINGS_MODULE=syntel.settings_production

# Database Configuration
DB_NAME=syntel_prod
DB_USER=syntel_user
DB_PASSWORD=your-secure-database-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=require

# Redis Configuration
REDIS_URL=redis://localhost:6379/1

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Security Configuration
SSL_CERT_PATH=/etc/ssl/certs/yourdomain.crt
SSL_KEY_PATH=/etc/ssl/private/yourdomain.key

# Monitoring and Logging
SENTRY_DSN=https://your-sentry-dsn-here
LOG_LEVEL=INFO

# Performance Configuration
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# SSL/HTTPS Configuration
SSL_REDIRECT=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

# Session and Cookie Security
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# File Upload Configuration
FILE_UPLOAD_MAX_MEMORY_SIZE=104857600  # 100MB
DATA_UPLOAD_MAX_MEMORY_SIZE=104857600  # 100MB
FILE_UPLOAD_TEMP_DIR=/tmp

# Cache Configuration
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
CACHE_LOCATION=redis://127.0.0.1:6379/2

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TIMEZONE=UTC

# Admin Configuration
ADMIN_URL=admin/
DJANGO_ADMIN_URL=admin/

# API Configuration
REST_FRAMEWORK_DEFAULT_RENDERER_CLASSES=rest_framework.renderers.JSONRenderer
REST_FRAMEWORK_DEFAULT_PAGINATION_CLASS=rest_framework.pagination.PageNumberPagination
REST_FRAMEWORK_DEFAULT_PERMISSION_CLASSES=rest_framework.permissions.IsAuthenticated

# CORS Configuration (if needed)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOW_CREDENTIALS=True

# Monitoring Configuration
HEALTH_CHECK_URL=/health/
PROMETHEUS_METRICS_URL=/metrics/

# Third-party Service Configuration
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-key-here
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# Security Settings
DJANGO_DEBUG=False

# Optional: External Services
# NEW_RELIC_LICENSE_KEY=your-new-relic-key