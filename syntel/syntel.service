[Unit]
Description=Syntel Finance Management System - Gunicorn daemon
After=network.target

[Service]
Type=notify
User=root
Group=root
RuntimeDirectory=gunicorn
WorkingDirectory=/opt/project/Syntel-/syntel
Environment="PATH=/opt/project/Syntel-/syntel/venv/bin"
EnvironmentFile=/opt/project/Syntel-/syntel/.env.production
ExecStart=/opt/project/Syntel-/syntel/venv/bin/gunicorn \
    --config /opt/project/Syntel-/syntel/gunicorn_config.py \
    --env DJANGO_SETTINGS_MODULE=syntel.settings_production \
    syntel.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
