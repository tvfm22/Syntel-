# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/

# Git
.git/
.gitignore

# Environment (secrets stay out of the image)
.env
.env.*
!.env.example
!.env.production

# Runtime writable data — shipped into the image only via the DB seed (Dockerfile)
data/logs/
data/cache/
data/tmp/
data/sessions/
data/backups/
data/uploads/

# Django build artifacts
*.log
staticfiles/

# Tests / tooling
.pytest_cache/
.coverage
htmlcov/

# Local junk / stray files
temp/
Syntel-/
wget-log
db_data.json
purge_dead_files.ps1
purge_dead_files.sh

# Documentation (not needed at runtime)
*.md
docs/
