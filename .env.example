# =============================================================================
# Syntel — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# NEVER commit the .env file to version control.
# =============================================================================

# --- Django Core -----------------------------------------------------------

# Secret key — required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value

# Debug mode — set to "True" for local development only.
# In production this MUST be "False" (the default when omitted).
DJANGO_DEBUG=False

# Comma-separated list of allowed host/domain names.
# In production, replace with your actual domain(s):
#   ALLOWED_HOSTS=.example.com,api.example.com
# The default allows local development only.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (SQLite default; uncomment for PostgreSQL) --------------------
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=syntel
# DB_USER=syntel
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# --- Security / HTTPS (enable in production) --------------------------------
# CSRF_COOKIE_SECURE=True
# SESSION_COOKIE_SECURE=True

# --- Redis / Cache (optional, uncomment for production) ---------------------
# REDIS_URL=redis://localhost:6379/0

# --- Static / Media (optional, uncomment for S3) ----------------------------
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_STORAGE_BUCKET_NAME=syntel-static
# AWS_S3_REGION_NAME=me-south-1
